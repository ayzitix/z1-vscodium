+/* z1 welcome screen */
+.monaco-workbench .part.editor > .content .gettingStartedContainer.z1-welcome > .gettingStarted {
+	display: none !important;
+}
+
+.z1-welcome-page {
+	box-sizing: border-box;
+	height: 100%;
+	overflow: auto;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	padding: 32px;
+	background: var(--vscode-editor-background);
+	color: var(--vscode-editor-foreground);
+}
+
+.z1-welcome-inner {
+	width: 540px;
+	max-width: 100%;
+	transform: translateY(-16px);
+}
+
+.z1-welcome-brand {
+	display: flex;
+	align-items: center;
+	gap: 10px;
+	margin-bottom: 20px;
+}
+
+.z1-welcome-logo {
+	position: relative;
+	width: 34px;
+	height: 34px;
+	flex: 0 0 auto;
+}
+
+.z1-welcome-logo::before,
+.z1-welcome-logo::after {
+	content: '';
+	position: absolute;
+	inset: 0;
+	background-size: contain;
+	background-repeat: no-repeat;
+	background-position: center;
+}
+
