+/* z1 welcome screen */
+.monaco-workbench .part.editor > .content .gettingStartedContainer.z1-welcome > .gettingStarted {
+	display: none !important;
+}
+
+.z1-welcome-page {
+	box-sizing: border-box;
+	height: 100%;
+	overflow: auto;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	padding: 32px;
+	background: var(--vscode-editor-background);
+	color: var(--vscode-editor-foreground);
+}
+
+.z1-welcome-inner {
+	width: 540px;
+	max-width: 100%;
+}
+
+.z1-welcome-brand {
+	display: flex;
+	align-items: center;
+	gap: 10px;
+	margin-bottom: 28px;
+}
+
+.z1-welcome-logo {
+	width: 34px;
+	height: 34px;
+	flex: 0 0 auto;
+	background-image: url('../../../../browser/media/code-icon.svg');
+	background-size: contain;
+	background-repeat: no-repeat;
+	background-position: center;
+}
+
+.z1-welcome-name {
+	font-size: 28px;
+	font-weight: 700;
+	line-height: 34px;
+	letter-spacing: 0.01em;
+}
+
+.z1-welcome-grid {
+	display: grid;
+	grid-template-columns: repeat(2, minmax(0, 1fr));
+	gap: 12px;
+}
+
+.z1-welcome-card {
+	position: relative;
+	display: flex;
+	flex-direction: column;
+	align-items: flex-start;
+	justify-content: space-between;
+	gap: 10px;
+	min-height: 84px;
+	box-sizing: border-box;
+	padding: 14px;
+	text-align: left;
+	background: color-mix(in srgb, var(--vscode-editor-foreground) 6%, var(--vscode-editor-background));
+	color: var(--vscode-editor-foreground);
+	border: 1px solid var(--vscode-widget-border, var(--vscode-editorWidget-border, #2c2c33));
+	font: inherit;
+	text-align: left;
+	cursor: pointer;
+}
+
+.z1-welcome-card:hover {
+	background: var(--vscode-list-hoverBackground, color-mix(in srgb, var(--vscode-editor-foreground) 10%, var(--vscode-editor-background)));
+}
+
+.z1-welcome-card:focus-visible {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
+
+.z1-welcome-card .codicon {
+	font-size: 22px;
+	line-height: 22px;
+}
+
+.z1-welcome-card-label {
+	font-size: 14px;
+	line-height: 20px;
+}
+
+.z1-welcome-card.z1-welcome-github {
+	background: #f5f5f5;
+	color: #141414;
+	border-color: #f5f5f5;
+}
+
+.z1-welcome-card.z1-welcome-github:hover {
+	background: #ffffff;
+}
+
+.z1-welcome-external {
+	position: absolute;
+	top: 12px;
+	right: 12px;
+	font-size: 14px !important;
+}
+
+@media (max-width: 640px) {
+	.z1-welcome-page {
+		padding: 24px;
+	}
+
+	.z1-welcome-grid {
+		grid-template-columns: 1fr;
+	}
+}
