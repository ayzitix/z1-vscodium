+
+.z1-welcome-logo::after {
+	background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20300%20300%22%3E%3Cellipse%20cx%3D%22202.837%22%20cy%3D%22113.514%22%20rx%3D%2231.5%22%20ry%3D%2242%22%20transform%3D%22rotate%28-9.24205%20202.837%20113.514%29%22%20fill%3D%22%232A2A2A%22%2F%3E%3Cellipse%20cx%3D%22121.657%22%20cy%3D%22123.393%22%20rx%3D%2231.5%22%20ry%3D%2242%22%20transform%3D%22rotate%28-8.95985%20121.657%20123.393%29%22%20fill%3D%22%232A2A2A%22%2F%3E%3C%2Fsvg%3E");
