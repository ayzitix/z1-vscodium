    "terminal.foreground": "#d6d6db",
    "terminalCursor.foreground": "#c8f56a",
    "terminal.selectionBackground": "#ff6fa538",
    "terminal.ansiGreen": "#c8f56a",
    "terminal.ansiBrightGreen": "#d7ff8d",
    "terminal.ansiMagenta": "#ff6fa5",
    "terminal.ansiBrightMagenta": "#ffa1c4",
    "terminal.ansiRed": "#ff6b6b",
    "terminal.ansiBrightRed": "#ff8a8a",
    "terminal.ansiYellow": "#f2c46d",
    "terminal.ansiBrightYellow": "#ffd98a",
    "terminal.ansiBlue": "#8ab4ff",
    "terminal.ansiBrightBlue": "#a8c7ff",
