    "chat.requestBubbleHoverBackground": "#ffffff14",
    "chat.slashCommandBackground": "#c8f56a1f",
    "chat.slashCommandForeground": "#c8f56a"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#6e6e78", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string punctuation.section.embedded source", "punctuation.definition.string"],
      "settings": { "foreground": "#c8f56a" }
    },
    {
      "scope": ["string.regexp", "source.regexp"],
      "settings": { "foreground": "#d7ff8d" }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language", "support.constant", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#ffa1c4" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression"],
      "settings": { "foreground": "#ff6fa5" }
    },
    {
      "scope": ["keyword.operator", "punctuation", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#9a9aa3" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#d7ff8d" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#ffa1c4" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#ff6fa5" }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.object-literal.key", "support.type.property-name"],
      "settings": { "foreground": "#c8f56a" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#e8e8ea" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.super"],
      "settings": { "foreground": "#ff6fa5", "fontStyle": "italic" }
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.broken"],
      "settings": { "foreground": "#ff6b6b" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#c8f56a", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.raw"],
      "settings": { "foreground": "#c8f56a" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#c8f56a" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff6b6b" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#f2c46d" }
    },
    {
      "scope": ["token.info-token"],
      "settings": { "foreground": "#c8f56a" }
    },
    {
      "scope": ["token.warn-token"],
      "settings": { "foreground": "#f2c46d" }
    },
    {
      "scope": ["token.error-token"],
      "settings": { "foreground": "#ff6b6b" }
    },
    {
      "scope": ["token.debug-token"],
      "settings": { "foreground": "#ffa1c4" }
    }
  ]
}
